<article id="<%= dom_id movie %>" class="card movie-card">
  <h1><%= movie.title %></h1>

  <dl class="movie-details">
    <dt>Rating</dt>
    <dd><span class="rating-badge"><%= movie.rating %></span></dd>

    <dt>Release date</dt>
    <dd><%= format_release_date(movie) %></dd>

    <dt>Description</dt>
    <dd><%= movie.description.presence || "No description yet." %></dd>
  </dl>
</article>
