<%= form_with(model: movie, class: "card movie-form") do |form| %>
  <% if movie.errors.any? %>
    <div class="form-errors" role="alert">
      <h2><%= pluralize(movie.errors.count, "error") %> prohibited this movie from being saved:</h2>

      <ul>
        <% movie.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true %>
  </div>

  <div class="field-row">
    <div class="field">
      <%= form.label :rating %>
      <%= form.select :rating, Movie::RATINGS, include_blank: "Choose a rating" %>
    </div>

    <div class="field">
      <%= form.label :release_date %>
      <%= form.date_field :release_date %>
    </div>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 4 %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "button" %>
  </div>
<% end %>
